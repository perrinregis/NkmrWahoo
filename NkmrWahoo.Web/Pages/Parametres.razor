@page "/parametres"
@inject IJSRuntime JSRuntime
@inject ILocalStorageService LocalStorage
@inject IWorkoutService WorkoutService

<PageTitle>Paramètres - NkmrWahoo</PageTitle>

<div class="max-w-3xl mx-auto p-4 space-y-6">
    <h2 class="text-2xl font-bold mb-4">Réglages & Profil Cycliste</h2>

    <div class="space-y-4">
        <!-- Section Profil Cycliste & FTP -->
        <div class="card bg-base-100 shadow-xl border border-base-300">
            <div class="card-body">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-primary/10 rounded-lg text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="card-title text-xl">Profil de Puissance (FTP)</h3>
                        <p class="text-sm opacity-70">Votre Functional Threshold Power sert de référence pour calculer les Watts de vos entraînements.</p>
                    </div>
                </div>

                <div class="mt-4 flex flex-col sm:flex-row items-center gap-4">
                    <div class="form-control w-full sm:w-60">
                        <label class="label">
                            <span class="label-text font-bold">Valeur FTP (Watts)</span>
                        </label>
                        <div class="join">
                            <input type="number" min="50" max="600" step="5" class="input input-bordered join-item w-full text-xl font-bold text-center" @bind="userFtp" />
                            <span class="btn btn-neutral join-item pointer-events-none">W</span>
                        </div>
                    </div>

                    <div class="flex gap-2 mt-2 sm:mt-8">
                        <button class="btn btn-outline" @onclick="() => AdjustFtp(-5)">-5</button>
                        <button class="btn btn-outline" @onclick="() => AdjustFtp(5)">+5</button>
                        <button class="btn btn-primary" @onclick="SaveFtp">Enregistrer</button>
                    </div>
                </div>

                @if (saveMessageVisible)
                {
                    <div class="alert alert-success mt-3 py-2 text-sm shadow">
                        <span>FTP enregistrée avec succès (@userFtp W) !</span>
                    </div>
                }

                <!-- Aperçu des zones de puissance selon la FTP -->
                <div class="mt-6 border-t border-base-300 pt-4">
                    <h4 class="text-sm font-semibold mb-3">Vos Zones d'entraînement selon cette FTP :</h4>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
                        <div class="p-2 rounded bg-base-200 border-l-4 border-slate-400">
                            <div class="font-bold">Z1 Récupération</div>
                            <div>&lt; @Math.Round(userFtp * 0.55) W (&lt; 55%)</div>
                        </div>
                        <div class="p-2 rounded bg-base-200 border-l-4 border-sky-400">
                            <div class="font-bold">Z2 Endurance</div>
                            <div>@Math.Round(userFtp * 0.55) - @Math.Round(userFtp * 0.75) W (56-75%)</div>
                        </div>
                        <div class="p-2 rounded bg-base-200 border-l-4 border-green-500">
                            <div class="font-bold">Z3 Tempo</div>
                            <div>@Math.Round(userFtp * 0.76) - @Math.Round(userFtp * 0.90) W (76-90%)</div>
                        </div>
                        <div class="p-2 rounded bg-base-200 border-l-4 border-yellow-500">
                            <div class="font-bold">Z4 Seuil (FTP)</div>
                            <div>@Math.Round(userFtp * 0.91) - @Math.Round(userFtp * 1.05) W (91-105%)</div>
                        </div>
                        <div class="p-2 rounded bg-base-200 border-l-4 border-orange-500">
                            <div class="font-bold">Z5 VO2 Max</div>
                            <div>@Math.Round(userFtp * 1.06) - @Math.Round(userFtp * 1.20) W (106-120%)</div>
                        </div>
                        <div class="p-2 rounded bg-base-200 border-l-4 border-red-500">
                            <div class="font-bold">Z6 Anaérobie</div>
                            <div>&gt; @Math.Round(userFtp * 1.20) W (&gt; 120%)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section Thème Accordéon -->
        <details class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300 group">
            <summary class="collapse-title text-xl font-medium flex items-center gap-3">
                <div class="p-2 bg-primary/10 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                    </svg>
                </div>
                Choisir un thème visuel
            </summary>
            <div class="collapse-content">
                <p class="text-sm opacity-70 mb-4 px-2">Personnalisez l'apparence de votre application</p>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3 p-2">
                    @foreach (var theme in themes)
                    {
                        <button class="btn btn-outline @(currentTheme == theme.Key ? "btn-active" : "")" 
                                @onclick="() => ChangeTheme(theme.Key)">
                            @theme.Value
                        </button>
                    }
                </div>
            </div>
        </details>
        
        <!-- Section Gestion des Données -->
        <div class="card bg-base-100 shadow-xl border border-base-300">
            <div class="card-body">
                <h3 class="card-title text-xl">💾 Données locales</h3>
                <p class="text-sm opacity-70">Réinitialiser les séances d'entraînement par défaut de l'application si nécessaire.</p>
                <div class="card-actions justify-end mt-2">
                    <button class="btn btn-warning btn-outline btn-sm" @onclick="ResetWorkouts">Recharger les séances d'exemples</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int userFtp = 200;
    private bool saveMessageVisible = false;
    private string currentTheme = "dark";

    private Dictionary<string, string> themes = new()
    {
        { "light", "Light" },
        { "dark", "Dark" },
        { "cupcake", "Cupcake" },
        { "retro", "Retro" },
        { "cyberpunk", "Cyberpunk" },
        { "valentine", "Valentine" },
        { "aqua", "Aqua" },
        { "dracula", "Dracula" },
        { "nord", "Nord" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            userFtp = await WorkoutService.GetFtpAsync();
            currentTheme = await LocalStorage.GetItemAsync<string>("Theme") ?? "dark";
        }
        catch { }
    }

    private void AdjustFtp(int delta)
    {
        userFtp += delta;
        if (userFtp < 50) userFtp = 50;
        if (userFtp > 600) userFtp = 600;
    }

    private async Task SaveFtp()
    {
        await WorkoutService.SetFtpAsync(userFtp);
        saveMessageVisible = true;
        StateHasChanged();
        await Task.Delay(2500);
        saveMessageVisible = false;
        StateHasChanged();
    }

    private async Task ResetWorkouts()
    {
        await WorkoutService.ResetToSampleWorkoutAsync();
        saveMessageVisible = true;
        StateHasChanged();
    }

    private async Task ChangeTheme(string theme)
    {
        currentTheme = theme;
        await JSRuntime.InvokeVoidAsync("themeManager.setTheme", theme);
        await LocalStorage.SetItemAsync("Theme", theme);
    }
}
