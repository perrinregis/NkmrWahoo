@page "/remote"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Télécommande Guidon - NkmrWahoo</PageTitle>

<div class="min-h-screen bg-base-300 text-base-content flex flex-col justify-between p-3 select-none">
    <!-- 1. EN-TÊTE COMPANION -->
    <header class="flex items-center justify-between bg-base-100/90 backdrop-blur rounded-2xl p-3 border border-base-content/10 shadow-lg">
        <div class="flex items-center gap-2">
            <span class="relative flex h-3 w-3">
                @if (isConnected)
                {
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-success"></span>
                }
                else
                {
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-warning"></span>
                }
            </span>
            <div>
                <h1 class="font-black text-sm leading-tight truncate max-w-[180px] sm:max-w-xs">
                    @(string.IsNullOrEmpty(state.WorkoutName) ? "Télécommande NkmrWahoo" : state.WorkoutName)
                </h1>
                <div class="text-[10px] opacity-70">
                    @(isConnected ? "Connecté au Grand Écran" : "Recherche du Grand Écran...")
                </div>
            </div>
        </div>

        @if (isConnected)
        {
            <div class="badge badge-sm font-bold text-white shadow" style="background-color: @state.ZoneColor">
                @state.ZoneName
            </div>
        }
    </header>

    @if (!isConnected)
    {
        <!-- ÉCRAN D'ATTENTE DE CONNEXION AVEC SCANNER CAMÉRA INTÉGRÉ -->
        <main class="flex-1 flex flex-col items-center justify-center gap-4 text-center p-3 animate-fade-in">
            <div>
                <h2 class="text-lg font-black flex items-center justify-center gap-2">
                    <span>📷</span> Scanner l'écran du PC
                </h2>
                <p class="text-xs opacity-70 max-w-xs mt-0.5">
                    Visez le QR Code affiché sur votre PC pour connecter instantanément la télécommande.
                </p>
            </div>

            <!-- Lecteur Caméra QR Code -->
            <div class="card bg-base-100 p-3 border border-base-content/10 max-w-xs w-full shadow-2xl flex flex-col items-center gap-2">
                <div class="relative w-full aspect-square max-w-[260px] bg-black rounded-2xl shadow-inner overflow-hidden ring-4 ring-primary/20">
                    <div id="videoFeed" class="w-full h-full [&>video]:object-cover [&>video]:w-full [&>video]:h-full"></div>
                    <div class="absolute inset-0 border-2 border-primary/50 pointer-events-none rounded-2xl"></div>

                    @if (isCameraActive)
                    {
                        <div class="absolute top-0 left-0 w-full h-1 bg-primary shadow-[0_0_15px_rgba(59,130,246,0.9)] animate-scan pointer-events-none"></div>
                    }

                    @if (!isCameraActive && !isConnecting)
                    {
                        <div class="absolute inset-0 flex flex-col items-center justify-center bg-base-200/90 gap-2 p-4">
                            <span class="text-3xl">📷</span>
                            <span class="text-xs font-semibold opacity-75">Caméra en pause</span>
                            <button class="btn btn-primary btn-sm rounded-full shadow" @onclick="StartScanner">
                                Activer la caméra
                            </button>
                        </div>
                    }

                    @if (isConnecting)
                    {
                        <div class="absolute inset-0 flex flex-col items-center justify-center bg-black/85 backdrop-blur-sm gap-2 text-white">
                            <span class="loading loading-spinner loading-md text-primary"></span>
                            <span class="text-xs font-bold font-mono">Connexion au PC en cours...</span>
                        </div>
                    }
                </div>

                @if (isCameraActive)
                {
                    <div class="flex items-center justify-between w-full px-2 text-xs font-semibold">
                        <span class="flex items-center gap-1.5 opacity-80">
                            <span class="loading loading-spinner loading-xs text-primary"></span>
                            Recherche QR Code...
                        </span>
                        <button class="btn btn-ghost btn-xs text-error" @onclick="StopScanner">Arrêter</button>
                    </div>
                }
            </div>

            <!-- Alternative : saisie manuelle du code PIN -->
            <div class="card bg-base-100 p-3 border border-base-content/10 max-w-xs w-full shadow flex flex-col gap-2">
                <div class="text-left flex items-center justify-between">
                    <label class="text-[11px] font-bold opacity-80">Ou code PIN à 6 chiffres :</label>
                    @if (!string.IsNullOrEmpty(targetHostId))
                    {
                        <span class="text-[10px] font-mono text-primary font-bold">@targetHostId</span>
                    }
                </div>
                <div class="join w-full">
                    <input class="input input-sm input-bordered join-item w-full font-mono text-center text-lg font-black tracking-widest" 
                           type="text" 
                           inputmode="numeric" 
                           pattern="[0-9]*"
                           maxlength="6" 
                           placeholder="ex: 123456" 
                           @bind="manualHostId" 
                           @onkeyup="@(async e => { if (e.Key == "Enter") await ConnectManual(); })" />
                    <button class="btn btn-sm btn-primary join-item font-bold" @onclick="ConnectManual" disabled="@isConnecting">
                        @if (isConnecting)
                        {
                            <span class="loading loading-spinner loading-xs"></span>
                        }
                        else
                        {
                            <span>OK</span>
                        }
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-warning text-xs py-2 px-3 max-w-xs shadow">
                    <span>⚠️ @errorMessage</span>
                </div>
            }
        </main>
    }
    else
    {
        <!-- 2. COCKPIT TÉLÉCOMMANDE GUIDON (GROS BOUTONS) -->
        <main class="flex-1 flex flex-col justify-center gap-3 py-2">
            <!-- CARTE COMPTEURS GÉANTS -->
            <div class="grid grid-cols-3 gap-2">
                <!-- Puissance Réelle / Cible -->
                <div class="bg-base-100 rounded-2xl p-3 border border-base-content/10 shadow flex flex-col items-center justify-center text-center">
                    <div class="text-[10px] uppercase font-bold tracking-wider opacity-60">Puissance</div>
                    <div class="text-2xl sm:text-3xl font-black text-primary leading-tight">
                        @state.Power
                    </div>
                    <div class="text-[11px] font-bold text-warning">
                        / @state.TargetWatts W
                    </div>
                </div>

                <!-- Cadence -->
                <div class="bg-base-100 rounded-2xl p-3 border border-base-content/10 shadow flex flex-col items-center justify-center text-center">
                    <div class="text-[10px] uppercase font-bold tracking-wider opacity-60">Cadence</div>
                    <div class="text-2xl sm:text-3xl font-black text-secondary leading-tight">
                        @state.Cadence
                    </div>
                    <div class="text-[11px] opacity-70">
                        RPM
                    </div>
                </div>

                <!-- Décompte Palier -->
                <div class="bg-base-100 rounded-2xl p-3 border border-base-content/10 shadow flex flex-col items-center justify-center text-center">
                    <div class="text-[10px] uppercase font-bold tracking-wider opacity-60">Palier</div>
                    <div class="text-2xl sm:text-3xl font-black font-mono text-accent leading-tight">
                        @FormatTime(state.StepRemainingSeconds)
                    </div>
                    <div class="text-[10px] opacity-70">
                        @(state.CurrentStepIndex + 1)/@state.TotalSteps
                    </div>
                </div>
            </div>

            <!-- RÉGLAGE GÉANT DE L'INTENSITÉ / FTP BIAS -->
            <div class="bg-base-100 rounded-2xl p-3 border border-base-content/10 shadow flex flex-col gap-2">
                <div class="flex items-center justify-between text-xs font-bold px-1 opacity-70">
                    <span>RÉGLAGE INTENSITÉ</span>
                    <span class="text-primary font-mono text-sm">@state.IntensityBias% (@state.TargetWatts W)</span>
                </div>
                <div class="flex items-center gap-3">
                    <button class="btn btn-neutral btn-lg flex-1 text-2xl font-black h-16 shadow active:scale-95 transition-transform"
                            @onclick="() => AdjustIntensity(-1)">
                        -1%
                    </button>
                    <button class="btn btn-neutral btn-lg flex-1 text-2xl font-black h-16 shadow active:scale-95 transition-transform"
                            @onclick="() => AdjustIntensity(1)">
                        +1%
                    </button>
                </div>
            </div>

            <!-- CONTRÔLES PALIERS & PLAY / PAUSE -->
            <div class="grid grid-cols-4 gap-2">
                <button class="btn btn-outline btn-lg h-14 font-bold text-lg rounded-2xl shadow active:scale-95"
                        @onclick="PreviousStep"
                        title="Palier précédent">
                    ⏮
                </button>

                <button class="btn @(state.IsRunning ? "btn-warning" : "btn-success") btn-lg col-span-2 h-14 font-black text-lg rounded-2xl shadow-xl active:scale-95"
                        @onclick="TogglePlay">
                    @(state.IsRunning ? "⏸ PAUSE" : "▶ REPRENDRE")
                </button>

                <button class="btn btn-outline btn-lg h-14 font-bold text-lg rounded-2xl shadow active:scale-95"
                        @onclick="NextStep"
                        title="Palier suivant">
                    ⏭
                </button>
            </div>
        </main>
    }

    <!-- 3. PIED DE PAGE : TEMPS TOTAL RESTANT -->
    <footer class="bg-base-100/90 backdrop-blur rounded-2xl p-2.5 border border-base-content/10 text-center flex items-center justify-between text-xs font-semibold shadow">
        <span class="opacity-70">Séance totale :</span>
        <span class="font-mono text-accent font-bold">
            @FormatTime(state.TotalRemainingSeconds) / @FormatTime(state.TotalSeconds)
        </span>
        <a href="workouts" class="btn btn-ghost btn-xs text-error">Quitter</a>
    </footer>
</div>

<style>
    @@keyframes scan {
        0%, 100% { top: 0%; }
        50% { top: 100%; }
    }
    .animate-scan {
        animation: scan 2.5s ease-in-out infinite;
    }
</style>

@code {
    private DotNetObjectReference<Remote>? dotNetHelper;
    private bool isConnected = false;
    private bool isConnecting = false;
    private bool isCameraActive = false;
    private string targetHostId = "";
    private string manualHostId = "";
    private string errorMessage = "";

    private RemoteWorkoutState state = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetHelper = DotNetObjectReference.Create(this);

            try
            {
                // Empêche le smartphone de s'éteindre sur le guidon
                await JSRuntime.InvokeVoidAsync("workoutScreen.requestWakeLock");
            }
            catch { }

            // 1. Essai depuis le query param ?session=123456
            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var sessionFromQuery = query["session"];

            // 2. Essai depuis le hash #nkmr-123456 ou #123456
            var hash = uri.Fragment.TrimStart('#');

            // 3. Fallback direct via JS window.location au cas où Blazor n'a pas tout dans Navigation.Uri
            string jsHash = "";
            string jsQuery = "";
            try
            {
                jsHash = await JSRuntime.InvokeAsync<string>("eval", "window.location.hash || ''");
                jsQuery = await JSRuntime.InvokeAsync<string>("eval", "window.location.search || ''");
            }
            catch { }

            string foundId = "";
            if (!string.IsNullOrEmpty(sessionFromQuery))
            {
                foundId = sessionFromQuery;
            }
            else if (!string.IsNullOrEmpty(hash))
            {
                foundId = hash;
            }
            else if (!string.IsNullOrEmpty(jsQuery) && jsQuery.Contains("session="))
            {
                var m = System.Text.RegularExpressions.Regex.Match(jsQuery, @"session=([a-zA-Z0-9_-]+)");
                if (m.Success) foundId = m.Groups[1].Value;
            }
            else if (!string.IsNullOrEmpty(jsHash))
            {
                foundId = jsHash.TrimStart('#');
            }

            if (!string.IsNullOrEmpty(foundId))
            {
                var pinOnly = foundId.Replace("nkmr-", "");
                manualHostId = pinOnly;
                if (!foundId.StartsWith("nkmr-", StringComparison.OrdinalIgnoreCase))
                {
                    foundId = "nkmr-" + foundId;
                }
                targetHostId = foundId;
                await ConnectToHost(targetHostId);
            }
            else
            {
                _ = StartScanner();
            }
        }
    }

    private async Task StartScanner()
    {
        if (isCameraActive || isConnected) return;
        isCameraActive = true;
        errorMessage = "";
        StateHasChanged();

        await Task.Delay(250);

        try
        {
            var scanned = await JSRuntime.InvokeAsync<string>("qrScanner.startScanner", "videoFeed", null, true);
            if (!string.IsNullOrWhiteSpace(scanned))
            {
                await StopScanner();
                var id = ExtractHostId(scanned);
                if (!string.IsNullOrEmpty(id))
                {
                    manualHostId = id.Replace("nkmr-", "");
                    targetHostId = id;
                    await ConnectToHost(targetHostId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Scanner caméra indisponible : {ex.Message}");
            isCameraActive = false;
            StateHasChanged();
        }
    }

    private async Task StopScanner()
    {
        if (!isCameraActive) return;
        isCameraActive = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("qrScanner.stopScanner", "videoFeed");
        }
        catch { }
        StateHasChanged();
    }

    private string ExtractHostId(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        raw = raw.Trim();

        if (Uri.TryCreate(raw, UriKind.Absolute, out Uri? uri))
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var session = query["session"];
            if (!string.IsNullOrEmpty(session))
            {
                return session.StartsWith("nkmr-", StringComparison.OrdinalIgnoreCase) ? session : "nkmr-" + session;
            }
            var frag = uri.Fragment.TrimStart('#');
            if (!string.IsNullOrEmpty(frag))
            {
                return frag.StartsWith("nkmr-", StringComparison.OrdinalIgnoreCase) ? frag : "nkmr-" + frag;
            }
        }

        if (raw.Contains("session="))
        {
            var m = System.Text.RegularExpressions.Regex.Match(raw, @"session=([a-zA-Z0-9_-]+)");
            if (m.Success)
            {
                var val = m.Groups[1].Value;
                return val.StartsWith("nkmr-", StringComparison.OrdinalIgnoreCase) ? val : "nkmr-" + val;
            }
        }

        if (raw.StartsWith("nkmr-", StringComparison.OrdinalIgnoreCase))
        {
            return raw;
        }

        return "nkmr-" + raw;
    }

    private async Task ConnectToHost(string hostId)
    {
        errorMessage = "";
        isConnecting = true;
        StateHasChanged();
        try
        {
            await JSRuntime.InvokeVoidAsync("workoutRemote.connect", dotNetHelper, hostId);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            isConnecting = false;
            StateHasChanged();
        }
    }

    private async Task ConnectManual()
    {
        if (!string.IsNullOrWhiteSpace(manualHostId))
        {
            var code = manualHostId.Trim();
            if (!code.StartsWith("nkmr-", StringComparison.OrdinalIgnoreCase))
            {
                code = "nkmr-" + code;
            }
            targetHostId = code;
            await ConnectToHost(targetHostId);
        }
    }

    [JSInvokable]
    public void OnConnectedToHost()
    {
        _ = StopScanner();
        isConnected = true;
        isConnecting = false;
        errorMessage = "";
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDisconnectedFromHost()
    {
        isConnected = false;
        isConnecting = false;
        errorMessage = "Déconnecté du PC. Tentative de reconnexion...";
        StateHasChanged();
    }

    [JSInvokable]
    public void OnRemoteError(string error)
    {
        isConnecting = false;
        errorMessage = error;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnStateReceived(string json)
    {
        try
        {
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var newState = System.Text.Json.JsonSerializer.Deserialize<RemoteWorkoutState>(json, options);
            if (newState != null)
            {
                state = newState;
                isConnected = true;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task SendCommand(string action, int delta = 0)
    {
        var cmd = new { action, delta };
        var json = System.Text.Json.JsonSerializer.Serialize(cmd);
        try
        {
            await JSRuntime.InvokeVoidAsync("workoutRemote.sendCommand", json);
        }
        catch { }
    }

    private Task AdjustIntensity(int delta) => SendCommand("adjustIntensity", delta);
    private Task TogglePlay() => SendCommand("togglePlay");
    private Task PreviousStep() => SendCommand("prevStep");
    private Task NextStep() => SendCommand("nextStep");

    private string FormatTime(int seconds)
    {
        int m = Math.Max(0, seconds) / 60;
        int s = Math.Max(0, seconds) % 60;
        return $"{m:D2}:{s:D2}";
    }

    public void Dispose()
    {
        _ = StopScanner();
        try
        {
            _ = JSRuntime.InvokeVoidAsync("workoutRemote.dispose");
            _ = JSRuntime.InvokeVoidAsync("workoutScreen.releaseWakeLock");
        }
        catch { }
        dotNetHelper?.Dispose();
    }

    public class RemoteWorkoutState
    {
        public int Power { get; set; }
        public int TargetWatts { get; set; }
        public int Cadence { get; set; }
        public int StepRemainingSeconds { get; set; }
        public int TotalRemainingSeconds { get; set; }
        public int TotalSeconds { get; set; }
        public int IntensityBias { get; set; } = 100;
        public bool IsRunning { get; set; }
        public string ZoneName { get; set; } = "Zone Z2";
        public string ZoneColor { get; set; } = "#38bdf8";
        public int CurrentStepIndex { get; set; }
        public int TotalSteps { get; set; }
        public string WorkoutName { get; set; } = "";
    }
}
