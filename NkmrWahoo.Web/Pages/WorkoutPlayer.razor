@page "/workout-player/{Id}"
@layout Layout.WorkoutLayout
@implements IDisposable
@inject IWorkoutService WorkoutService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Séance MyWhoosh - @(workout?.Name ?? "Entraînement")</PageTitle>

@if (workout == null)
{
    <div class="flex justify-center items-center h-screen w-screen">
        <span class="loading loading-spinner loading-lg text-primary"></span>
    </div>
}
else
{
    <!-- OVERLAY EN CAS D'ORIENTATION PORTRAIT SUR SMARTPHONE -->
    <div class="portrait-warning fixed inset-0 z-[100] bg-neutral text-neutral-content flex flex-col items-center justify-center p-6 text-center md:hidden">
        <div class="text-6xl animate-spin mb-4" style="animation-duration: 4s;">🔄</div>
        <h2 class="text-2xl font-black mb-2">Mode Paysage Recommandé</h2>
        <p class="text-sm opacity-80 max-w-xs mb-6">
            Pour profiter du cockpit d'entraînement MyWhoosh avec la colonne des paliers et la frise, veuillez pivoter votre téléphone à l'horizontale.
        </p>
        <button class="btn btn-primary shadow-lg" @onclick="ForceLandscape">
            Pivoter en plein écran
        </button>
    </div>

    <!-- COCKPIT PLEIN ÉCRAN MYWHOOSH (100% LARGEUR & HAUTEUR DISPONIBLE) -->
    <div class="h-screen w-screen flex flex-row overflow-hidden bg-base-300 select-none text-base-content font-sans relative">
        
        <!-- ======================================================== -->
        <!-- PARTIE GAUCHE / CENTRALE : HUD HAUT + SCÈNE + FRISE BAS  -->
        <!-- ======================================================== -->
        <main class="flex-1 flex flex-col h-full overflow-hidden relative">
            
            <!-- 1. HUD DU HAUT ULTRA-COMPACT (1 SEULE LIGNE GÉANTE & SANS TEXTES INUTILES) -->
            <header class="flex-none bg-base-100/95 backdrop-blur border-b border-base-content/10 px-2 sm:px-3 py-1.5 shadow-md z-30">
                <div class="flex items-center justify-between gap-1.5 sm:gap-3">
                    
                    <!-- Burger compact + Chrono Palier (sans texte "Palier") -->
                    <div class="flex items-center gap-1.5 bg-base-200/80 rounded-lg py-1 px-2 border border-base-content/5 flex-none whitespace-nowrap">
                        <div class="dropdown dropdown-bottom">
                            <label tabindex="0" class="btn btn-ghost btn-circle btn-xs text-primary" title="Menu rapide">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                                </svg>
                            </label>
                            <ul tabindex="0" class="dropdown-content menu p-2 shadow-2xl bg-base-100 rounded-box w-52 z-[60] border border-base-content/10 text-xs">
                                <li><a @onclick="ConfirmExit">🚪 Quitter la séance</a></li>
                                <li><a @onclick="ForceLandscape">🖥️ Mode Plein écran</a></li>
                                <li><a href="parametres" target="_blank">⚙️ Réglages & FTP</a></li>
                            </ul>
                        </div>

                        <div class="text-xl sm:text-2xl font-black font-mono text-accent leading-none whitespace-nowrap">
                            @FormatTime(stepRemainingSeconds)
                        </div>
                    </div>

                    <!-- Puissance Réelle / Cible (ex: 20/90 W sur une seule ligne stricte) -->
                    <div class="bg-base-200/80 rounded-lg py-1 px-3 border border-base-content/5 flex items-baseline justify-center gap-1 whitespace-nowrap">
                        <span class="text-xl sm:text-2xl font-black text-primary whitespace-nowrap">@currentPower</span>
                        <span class="text-xs opacity-40">/</span>
                        <span class="text-base sm:text-lg font-bold text-warning whitespace-nowrap">@currentTargetWatts&nbsp;W</span>
                    </div>

                    <!-- Cadence (ex: 88 RPM sur une seule ligne) -->
                    <div class="bg-base-200/80 rounded-lg py-1 px-3 border border-base-content/5 flex items-baseline justify-center gap-1 whitespace-nowrap">
                        <span class="text-xl sm:text-2xl font-black text-secondary whitespace-nowrap">@currentCadence</span>
                        <span class="text-xs font-normal opacity-70 whitespace-nowrap">RPM</span>
                    </div>

                    <!-- Boutons Connexion / Déconnexion & Play / Pause (Icônes Pures) -->
                    <div class="flex items-center gap-1 sm:gap-1.5 flex-none ml-auto">
                        @if (isBtConnected)
                        {
                            <button class="btn btn-ghost btn-circle btn-xs text-success hover:bg-success/20 relative" @onclick="DisconnectBluetooth" title="@(isMockMode ? "Mock Connecté (cliquer pour déconnecter)" : "Bluetooth Connecté (cliquer pour déconnecter)")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7l10 10-5 5V2l5 5L7 17" />
                                </svg>
                                <span class="absolute top-0 right-0 block h-1.5 w-1.5 rounded-full ring-1 ring-base-100 bg-success"></span>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-ghost btn-circle btn-xs text-base-content/40 hover:text-primary hover:bg-base-200" @onclick="() => ConnectBluetooth(false)" title="Connecter le home-trainer Bluetooth">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7l10 10-5 5V2l5 5L7 17" />
                                </svg>
                            </button>
                        }

                        @if (isRunning)
                        {
                            <button class="btn btn-warning btn-circle btn-xs sm:btn-sm shadow" @onclick="PauseWorkout" title="Mettre en pause">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                                </svg>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-success btn-circle btn-xs sm:btn-sm shadow" @onclick="StartWorkout" title="Reprendre la séance">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M8 5v14l11-7z"/>
                                </svg>
                            </button>
                        }

                        <button class="btn btn-ghost btn-circle btn-xs text-error" @onclick="ConfirmExit" title="Quitter la séance">
                            ✕
                        </button>
                    </div>
                </div>
            </header>

            <!-- 2. SCÈNE CENTRALE (Route & Messages Coaching) -->
            <div class="flex-1 flex flex-col justify-between p-3 relative overflow-hidden bg-[#05060f]">
                <!-- Canvas Tron 3D Cyber Highway -->
                <canvas id="tron-highway-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>

                <!-- EN HAUT : Badge discret de Zone (placé en haut pour dégager la perspective 3D) -->
                <div class="z-10 flex justify-center w-full pointer-events-none">
                    <div class="text-center select-none backdrop-blur-md bg-black/50 px-3 py-0.5 rounded-full border border-white/10 text-white/90 shadow-lg">
                        <span class="text-[11px] sm:text-xs font-bold tracking-wider uppercase">@currentStep?.GetZoneName(currentTargetRatio)</span>
                    </div>
                </div>

                <!-- AU CENTRE : Uniquement les messages de coaching alertes -->
                <div class="z-10 flex flex-col items-center justify-center flex-1 pointer-events-none">
                    @if (!string.IsNullOrEmpty(activeMessage))
                    {
                        <div class="alert alert-info shadow-2xl py-3 px-5 max-w-lg text-center text-base sm:text-lg font-bold animate-bounce border-2 border-white/40 backdrop-blur-md bg-info/90 text-info-content pointer-events-auto">
                            <span>💬 @activeMessage</span>
                        </div>
                    }
                </div>

                <!-- Indicateur rapide palier suivant en bas de zone centrale -->
                @if (nextStep != null)
                {
                    <div class="z-10 bg-black/60 backdrop-blur-md rounded-md py-0.5 px-2 text-[11px] self-start flex items-center gap-1.5 border border-white/10 text-white">
                        <span class="opacity-60">À suivre :</span>
                        <span class="w-2 h-2 rounded-full" style="background-color: @nextStep.GetZoneColor(nextStep.IsRamp ? nextStep.StartPower : nextStep.Power)"></span>
                        <strong>@Math.Round((nextStep.IsRamp ? nextStep.StartPower : nextStep.Power) * userFtp) W</strong>
                        <span>(@FormatTime(nextStep.Time))</span>
                    </div>
                }
            </div>

            <!-- 3. BAS : FRISE HORIZONTALE RÉDUITE À LA LARGEUR DE CETTE SECTION -->
            <footer class="flex-none bg-base-100 border-t border-base-content/10 p-1.5 flex flex-col gap-1 z-30 shadow-2xl">
                <!-- Frise SVG avec ses vraies pentes et curseur en temps réel -->
                <WorkoutProfileSvg Workout="@workout"
                                   CurrentStepIndex="@currentStepIndex"
                                   ElapsedTotalSeconds="@totalElapsedSeconds"
                                   HeightClass="h-12 sm:h-14"
                                   OnStepClicked="JumpToStep" />

                <!-- Contrôles rapides sous la frise avec Temps Restant et Puissance Cumulée au milieu -->
                <div class="flex items-center justify-between text-xs px-1 gap-2 whitespace-nowrap">
                    <!-- Gauche : Saut de paliers -->
                    <div class="flex items-center gap-1.5 flex-none">
                        <button class="btn btn-circle btn-xs btn-outline" @onclick="PreviousStep" disabled="@(currentStepIndex <= 0)" title="Palier précédent">
                            ⏮
                        </button>
                        <button class="btn btn-circle btn-xs btn-outline" @onclick="NextStep" disabled="@(currentStepIndex >= workout.WorkoutStepsArray.Count - 1)" title="Palier suivant">
                            ⏭
                        </button>
                        <span class="opacity-70 text-[11px] hidden sm:inline">Paliers</span>
                    </div>

                    <!-- Milieu : Temps restant / Temps total & Puissance cumulée (sans textes superflus) -->
                    <div class="flex items-center justify-center gap-3 sm:gap-6 text-xs font-semibold whitespace-nowrap">
                        <span class="font-mono font-black text-xs sm:text-sm text-accent whitespace-nowrap" title="Temps restant / Temps total">
                            @FormatTime(totalRemainingSeconds)/@FormatTime(workout.Time)
                        </span>
                        <span class="font-black text-xs sm:text-sm text-primary whitespace-nowrap" title="Puissance cumulée">
                            @totalKj&nbsp;kJ
                        </span>
                    </div>

                    <!-- Droite : Plein écran (icône bascule) & Quitter (icône sortie) -->
                    <div class="flex items-center gap-1.5 flex-none">
                        <!-- Bouton Plein écran / Réduire avec icônes SVG sans texte -->
                        <button class="btn btn-ghost btn-circle btn-xs text-base-content/80 hover:text-primary" @onclick="ToggleFullscreen" title="@(isFullscreen ? "Quitter le plein écran" : "Plein écran")">
                            @if (isFullscreen)
                            {
                                <!-- Icône Réduire / Compress -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9L4 4m0 0h4m-4 0v4m11 0l5-5m0 0h-4m4 0v4M9 15l-5 5m0 0h4m-4 0v-4m11 0l5 5m0 0h-4m4 0v-4" />
                                </svg>
                            }
                            else
                            {
                                <!-- Icône Agrandir / Expand -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                                </svg>
                            }
                        </button>

                        <!-- Bouton Quitter : Icône de sortie (Log-out) rouge sans texte -->
                        <button class="btn btn-ghost btn-circle btn-xs text-error hover:bg-error/20" @onclick="ConfirmExit" title="Quitter la séance">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                        </button>
                    </div>
                </div>
            </footer>
        </main>

        <!-- ======================================================== -->
        <!-- PARTIE DROITE : ASCENSEUR DES PALIERS (PLEINE HAUTEUR !) -->
        <!-- ======================================================== -->
        <aside class="w-48 sm:w-56 flex-none h-full bg-base-100 border-l border-base-content/10 flex flex-col z-30 shadow-2xl">
            <!-- En-tête de la colonne -->
            <div class="p-2 border-b border-base-content/10 bg-base-200/80 flex justify-between items-center text-xs font-bold flex-none">
                <span>Paliers (@(currentStepIndex + 1)/@workout.WorkoutStepsArray.Count)</span>
                <span class="badge badge-sm badge-neutral">@workout.FormattedTotalTime</span>
            </div>

            <!-- Ascenseur / Liste verticale des 30 étapes (PREND TOUTE LA HAUTEUR) -->
            <div class="flex-1 overflow-y-auto p-1.5 space-y-1 text-xs" id="workout-steps-container">
                @for (int i = 0; i < workout.WorkoutStepsArray.Count; i++)
                {
                    var idx = i;
                    var step = workout.WorkoutStepsArray[idx];
                    var isCurrent = (idx == currentStepIndex);
                    var isPast = (idx < currentStepIndex);
                    var ratio = step.IsRamp ? ((step.StartPower + step.EndPower) / 2.0) : step.Power;
                    var targetW = (int)Math.Round(ratio * userFtp * (intensityBias / 100.0));
                    var zoneColor = step.GetZoneColor(ratio);

                    <div id="step-row-@idx"
                         class="p-1.5 rounded-lg border transition-all cursor-pointer flex items-center justify-between gap-1.5 @(isCurrent ? "bg-primary text-primary-content font-bold shadow-md border-primary ring-2 ring-primary/40 scale-[1.01]" : isPast ? "opacity-40 bg-base-200/40 border-transparent hover:opacity-80" : "bg-base-200/80 border-base-content/5 hover:border-base-content/20")"
                         @onclick="() => JumpToStep(idx)">
                        <div class="flex items-center gap-1.5 truncate">
                            <span class="w-1.5 h-6 rounded-full flex-none" style="background-color: @zoneColor"></span>
                            <div class="truncate">
                                <div class="truncate leading-tight font-semibold">
                                    @(step.IsRamp ? $"Rampe {Math.Round(step.StartPower*userFtp)}→{Math.Round(step.EndPower*userFtp)}W" : $"{targetW} W")
                                </div>
                                <div class="text-[9px] opacity-70">
                                    @step.GetZoneName(ratio)
                                </div>
                            </div>
                        </div>

                        <div class="text-right font-mono flex-none font-bold text-xs">
                            @(isCurrent ? FormatTime(stepRemainingSeconds) : FormatTime(step.Time))
                        </div>
                    </div>
                }
            </div>

            <!-- Pied de la colonne droite : Réglage rapide FTP / Intensité (-1% et +1%) -->
            <div class="p-2 border-t border-base-content/10 bg-base-200/90 flex flex-col gap-1 flex-none shadow-inner">
                <div class="text-[10px] font-bold uppercase tracking-wider opacity-70 text-center">
                    Intensité : @intensityBias% (@currentTargetWatts W)
                </div>
                <div class="flex items-center justify-between gap-2">
                    <button class="btn btn-neutral btn-sm flex-1 font-bold text-sm" @onclick="() => AdjustIntensity(-1)">-1%</button>
                    <button class="btn btn-neutral btn-sm flex-1 font-bold text-sm" @onclick="() => AdjustIntensity(1)">+1%</button>
                </div>
            </div>
        </aside>
    </div>
}

<style>
    @@media (orientation: landscape) {
        .portrait-warning {
            display: none !important;
        }
    }
</style>

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private MyWhooshWorkout? workout;
    private int userFtp = 200;
    private int intensityBias = 100;

    // État
    private bool isRunning = false;
    private bool isFullscreen = false;
    private int currentStepIndex = 0;
    private int stepElapsedSeconds = 0;
    private int stepRemainingSeconds = 0;
    private int totalElapsedSeconds = 0;
    private int totalRemainingSeconds = 0;
    private long sumWattsSeconds = 0;

    // Métriques
    private int currentPower = 0;
    private int currentCadence = 0;
    private int currentTargetWatts = 0;
    private double currentTargetRatio = 0.0;
    private double speedKmh = 0.0;
    private int averageWatts = 0;
    private int totalKj = 0;
    private string activeMessage = "";
    private int messageDisplaySeconds = 0;

    // Bluetooth
    private bool isBtConnected = false;
    private bool isMockMode = false;
    private DotNetObjectReference<WorkoutPlayer>? dotNetHelper;

    // Timer
    private System.Threading.PeriodicTimer? periodicTimer;
    private CancellationTokenSource? timerCts;

    private WorkoutStep? currentStep => (workout != null && currentStepIndex < workout.WorkoutStepsArray.Count) 
        ? workout.WorkoutStepsArray[currentStepIndex] 
        : null;

    private WorkoutStep? nextStep => (workout != null && currentStepIndex + 1 < workout.WorkoutStepsArray.Count) 
        ? workout.WorkoutStepsArray[currentStepIndex + 1] 
        : null;

    protected override async Task OnInitializedAsync()
    {
        dotNetHelper = DotNetObjectReference.Create(this);
        userFtp = await WorkoutService.GetFtpAsync();
        workout = await WorkoutService.GetWorkoutByIdAsync(Id);

        if (workout != null && workout.WorkoutStepsArray.Count > 0)
        {
            totalRemainingSeconds = workout.Time;
            InitStep(0);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("workoutScreen.lockLandscape");
                await JSRuntime.InvokeVoidAsync("workoutScreen.requestWakeLock");
                await JSRuntime.InvokeVoidAsync("tronHighway.init", "tron-highway-canvas");
                await UpdateTronHighway();
            }
            catch { }
        }
    }

    private async Task UpdateTronHighway()
    {
        if (workout == null) return;
        try
        {
            var zoneHex = currentStep?.GetZoneColor(currentTargetRatio) ?? "#38bdf8";
            await JSRuntime.InvokeVoidAsync("tronHighway.update", speedKmh, currentCadence, currentTargetRatio, currentPower, isRunning, zoneHex, currentTargetWatts, stepRemainingSeconds);
        }
        catch { }
    }

    private async Task ForceLandscape()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("workoutScreen.lockLandscape");
            await JSRuntime.InvokeVoidAsync("workoutScreen.requestWakeLock");
            isFullscreen = true;
        }
        catch { }
    }

    private async Task ToggleFullscreen()
    {
        try
        {
            isFullscreen = await JSRuntime.InvokeAsync<bool>("workoutScreen.toggleFullscreen");
        }
        catch { }
    }

    private void InitStep(int stepIndex)
    {
        if (workout == null || stepIndex < 0 || stepIndex >= workout.WorkoutStepsArray.Count) return;

        currentStepIndex = stepIndex;
        stepElapsedSeconds = 0;
        stepRemainingSeconds = currentStep!.Time;
        activeMessage = "";

        // Recalculer le temps total écoulé et le temps restant selon le palier sélectionné
        totalElapsedSeconds = workout.WorkoutStepsArray.Take(stepIndex).Sum(s => s.Time);
        totalRemainingSeconds = Math.Max(0, workout.Time - totalElapsedSeconds);

        UpdateTargetPower(forceSendToTrainer: true);
        _ = UpdateTronHighway();

        _ = JSRuntime.InvokeVoidAsync("workoutScreen.scrollToActiveStep", $"step-row-{stepIndex}");
    }

    private void UpdateTargetPower(bool forceSendToTrainer = false)
    {
        if (currentStep == null) return;

        double baseRatio = currentStep.GetTargetPowerRatio(stepElapsedSeconds);
        currentTargetRatio = baseRatio * (intensityBias / 100.0);
        int newTargetWatts = (int)Math.Round(currentTargetRatio * userFtp);

        if (forceSendToTrainer || newTargetWatts != currentTargetWatts)
        {
            currentTargetWatts = Math.Max(newTargetWatts, 30);
            if (isBtConnected && isRunning)
            {
                _ = JSRuntime.InvokeAsync<bool>("wahooBluetooth.setTargetPower", currentTargetWatts);
            }
            _ = UpdateTronHighway();
        }
    }

    private async Task StartWorkout()
    {
        if (isRunning) return;

        isRunning = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("workoutScreen.requestWakeLock");
        }
        catch { }

        timerCts = new CancellationTokenSource();
        periodicTimer = new System.Threading.PeriodicTimer(TimeSpan.FromSeconds(1));

        UpdateTargetPower(forceSendToTrainer: true);
        _ = UpdateTronHighway();

        _ = RunWorkoutLoop(timerCts.Token);
    }

    private void PauseWorkout()
    {
        isRunning = false;
        timerCts?.Cancel();
        periodicTimer?.Dispose();
        periodicTimer = null;
        _ = UpdateTronHighway();

        if (isBtConnected)
        {
            _ = JSRuntime.InvokeAsync<bool>("wahooBluetooth.setTargetPower", Math.Min(currentTargetWatts, 100));
        }
    }

    private async Task RunWorkoutLoop(CancellationToken ct)
    {
        while (periodicTimer != null && await periodicTimer.WaitForNextTickAsync(ct))
        {
            if (!isRunning || workout == null || currentStep == null) break;

            stepElapsedSeconds++;
            stepRemainingSeconds--;
            totalElapsedSeconds++;
            totalRemainingSeconds = Math.Max(0, workout.Time - totalElapsedSeconds);

            int effectiveWatts = (currentPower > 0) ? currentPower : currentTargetWatts;
            sumWattsSeconds += effectiveWatts;
            averageWatts = (int)(sumWattsSeconds / Math.Max(totalElapsedSeconds, 1));
            totalKj = (int)Math.Round(sumWattsSeconds / 1000.0);

            // Modèle vitesse vélo : v = 3.6 * (P / 0.35)^(1/3)
            speedKmh = Math.Round(3.6 * Math.Pow(Math.Max(effectiveWatts, 10) / 0.35, 1.0 / 3.0), 1);

            // Coaching messages
            var msg = currentStep.WorkoutMessage.FirstOrDefault(m => m.Time == stepElapsedSeconds);
            if (msg != null)
            {
                activeMessage = msg.Message;
                messageDisplaySeconds = 8;
            }
            else if (messageDisplaySeconds > 0)
            {
                messageDisplaySeconds--;
                if (messageDisplaySeconds == 0) activeMessage = "";
            }

            // Rampes
            if (currentStep.IsRamp)
            {
                UpdateTargetPower(forceSendToTrainer: true);
            }

            // Fin de palier
            if (stepRemainingSeconds <= 0)
            {
                if (currentStepIndex < workout.WorkoutStepsArray.Count - 1)
                {
                    InitStep(currentStepIndex + 1);
                }
                else
                {
                    PauseWorkout();
                    activeMessage = "🎉 Entraînement terminé ! Félicitations !";
                    break;
                }
            }

            _ = UpdateTronHighway();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NextStep()
    {
        if (workout != null && currentStepIndex < workout.WorkoutStepsArray.Count - 1)
        {
            InitStep(currentStepIndex + 1);
        }
    }

    private void PreviousStep()
    {
        if (currentStepIndex > 0)
        {
            InitStep(currentStepIndex - 1);
        }
    }

    private void JumpToStep(int index)
    {
        if (index >= 0 && workout != null && index < workout.WorkoutStepsArray.Count)
        {
            InitStep(index);
        }
    }

    private void AdjustIntensity(int delta)
    {
        intensityBias = Math.Clamp(intensityBias + delta, 50, 150);
        UpdateTargetPower(forceSendToTrainer: true);
        _ = UpdateTronHighway();
    }

    private async Task ConnectBluetooth(bool useMock)
    {
        isMockMode = useMock;
        try
        {
            var res = await JSRuntime.InvokeAsync<string>("wahooBluetooth.connect", dotNetHelper, useMock);
            if (res.Contains("succès"))
            {
                isBtConnected = true;
                if (isRunning)
                {
                    await JSRuntime.InvokeAsync<bool>("wahooBluetooth.setTargetPower", currentTargetWatts);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur BT : {ex.Message}");
        }
    }

    private async Task DisconnectBluetooth()
    {
        isBtConnected = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("wahooBluetooth.disconnect");
        }
        catch { }
    }

    [JSInvokable]
    public void UpdatePower(int power)
    {
        currentPower = power;
        _ = UpdateTronHighway();
        StateHasChanged();
    }

    [JSInvokable]
    public void UpdateCadence(int cadence)
    {
        currentCadence = cadence;
        _ = UpdateTronHighway();
        StateHasChanged();
    }

    private string FormatTime(int seconds)
    {
        int m = Math.Max(0, seconds) / 60;
        int s = Math.Max(0, seconds) % 60;
        return $"{m:D2}:{s:D2}";
    }

    private async Task ConfirmExit()
    {
        PauseWorkout();
        try
        {
            await JSRuntime.InvokeVoidAsync("tronHighway.dispose");
            await JSRuntime.InvokeVoidAsync("workoutScreen.releaseWakeLock");
            await JSRuntime.InvokeVoidAsync("workoutScreen.unlockOrientation");
        }
        catch { }
        Navigation.NavigateTo("/workouts");
    }

    public void Dispose()
    {
        PauseWorkout();
        try
        {
            _ = JSRuntime.InvokeVoidAsync("tronHighway.dispose");
            _ = JSRuntime.InvokeVoidAsync("workoutScreen.releaseWakeLock");
        }
        catch { }
        dotNetHelper?.Dispose();
    }
}
